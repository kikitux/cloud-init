## template: jinja
#cloud-config

users:
  - name: kikitux
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: false

write_files:
  # profile
  - path: /home/kikitux/.bash_profile
    owner: kikitux:kikitux
    permissions: '0644'
    append: false
    content: |
      export XDG_RUNTIME_DIR="/run/user/$UID"
      export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
      export PATH="$PATH:/home/kikitux/.local/bin"

runcmd:
  # ---- ROOT TASKS ----
  - pvcreate -f {{ ds.meta_data.dev_myvg1 }}
  - vgcreate myvg1 {{ ds.meta_data.dev_myvg1 }}
  - sudo dnf install -y https://github.com/derailed/k9s/releases/latest/download/k9s_linux_amd64.rpm

final_message: "Disk setup, myvg1."
